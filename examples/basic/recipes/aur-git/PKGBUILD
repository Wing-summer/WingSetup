# Replace the example URL before using this recipe to build an application.
pkgname=wingsetup-hello-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='WingSetup VCS recipe template; configure a real source repository'
arch=('x86_64' 'aarch64')
license=('BSD-3-Clause')
makedepends=('git' 'cmake')
source=('demo::git+https://example.invalid/demo.git#branch=main')
sha256sums=('SKIP')
pkgver() {
    cd "$srcdir/demo"
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/-/.r/;s/-/./g'
}
build() {
    cmake -S "$srcdir/demo" -B "$srcdir/build" -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "$srcdir/build"
}
package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
